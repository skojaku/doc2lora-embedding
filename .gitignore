# This repository tracks reproduction PRIMITIVES only: the workflow, the scripts
# it calls, the libraries they import, and the documentation. Everything a rule
# can regenerate stays out.
#
# NOTE: git does not treat a trailing `#` as a comment, so every comment here is
# on its own line.

# ── Machine-specific configuration ───────────────────────────────────────
# workflow/config.yaml is your copy of workflow/config.template.yaml.
workflow/config.yaml
.env

# ── Everything a rule writes ─────────────────────────────────────────────
# data/ is the single output root: corpora you fetch, embeddings, adapters,
# score pools, decodes, and the generated tables and figures under results/.
# The Zenodo manifest and this directory's README are primitives. The sample
# corpus is not: `make_sample.py` generates it from a seed.
data/*
!data/ARTIFACTS.tsv
!data/README.md
results/
dist/

# ── Python / Snakemake / editors ─────────────────────────────────────────
.snakemake/
logs/
__pycache__/
*.py[cod]
*.egg-info/
.venv*/
.ipynb_checkpoints/
.DS_Store
